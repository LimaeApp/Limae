CREATE TABLE IF NOT EXISTS Note (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    lastModified INTEGER NOT NULL,
    CHECK((trim(title) <> '' OR trim(content) <> '') = 1 AND trim(id) <> '')
);

getAllNotes:
SELECT * FROM Note;

getANoteById:
SELECT * FROM Note WHERE id = :id;

deleteANoteById:
DELETE FROM Note WHERE id = :id;

insertANote:
INSERT OR IGNORE INTO Note (id,title, content,lastModified) VALUES (:id,:title,:content,:lastModified);

updateANoteById:
UPDATE Note SET title = :title, content = :content, lastModified = :lastModified WHERE id = :id;

deleteAllNotes:
DELETE FROM Note;